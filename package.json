{
  "name": "nevera-digital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test",
    "catalog:migration": "node scripts/buildCatalogMigration.ts",
    "db:push": "supabase db push --remote",
    "db:types": "supabase gen types --lang=typescript --remote --schema public > src/lib/database.types.ts",
    "shelf-life:migration": "node scripts/buildShelfLifeMigration.ts",
    "push:keys": "node scripts/generateVapidKeys.ts",
    "functions:deploy": "supabase functions deploy daily-digest send-test-push --use-api"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/query-async-storage-persister": "^5.107.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "fuse.js": "^7.5.0",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^8.5.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "supabase": "^3.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  }
}
