# Copia este archivo como .env.local y rellena los valores (SETUP.md, paso 4).
# Estos dos valores son públicos por diseño: la seguridad la da Row Level Security.
# Nunca pongas aquí la secret key (sb_secret_...) ni la contraseña de la base de datos.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
